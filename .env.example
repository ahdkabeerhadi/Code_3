# Database Configuration
# MongoDB connection string (replace with your production database)
DATABASE_URI=mongodb+srv://username:password@your-cluster.mongodb.net/your-database

# Payload CMS Secret
# Generate a secure random string for production (minimum 32 characters)
PAYLOAD_SECRET=your-secure-payload-secret-min-32-characters

# Server URL
# Update to your production domain (e.g., https://yourdomain.com)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Email Configuration (Option 1: Resend)
# Uncomment to use Resend email service
# RESEND_API_KEY=re_your_resend_api_key
# E_MAIL=your-email@yourdomain.com
# COMPANY_NAME=Your Company Name

# Email Configuration (Option 2: SMTP - Office 365 / Outlook)
# Uncomment and configure to use SMTP (Office 365, Gmail, etc.)
SMTP_HOST=smtp.office365.com
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your-smtp-app-password

# Vercel Blob Storage — public store, used for site media (logos, images)
# Get your token from Vercel dashboard
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# Vercel Blob Storage — separate PRIVATE store, used only for complaint form attachments.
# Must be a different store than BLOB_READ_WRITE_TOKEN above — keeps customer-submitted
# files off the public store.
COMPLAINTS_BLOB_TOKEN=vercel_blob_rw_your_private_token_here

# Google Places (homepage testimonials pull live Google Reviews when both are set)
# Find your Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id#find-id
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_ID=

# Search engine site verification meta tags (renders as <meta name="..." content="..."> on every page)
# Google Search Console: search.google.com/search-console -> Add property -> HTML tag method -> copy the "content" value only
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: bing.com/webmasters -> Add site (or import from Google Search Console) -> HTML Meta Tag method -> copy the "content" value only
BING_SITE_VERIFICATION=
